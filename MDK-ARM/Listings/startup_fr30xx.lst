  194 0000000E         ; Macro to define default exception/interrupt handlers.
  195 0000000E         ; Default handler are weak symbols with an endless loop.
                       
  196 0000000E         ; They can be overwritten by real handlers.
  197 0000000E                 MACRO
  198 0000000E                 Set_Default_Handler
                                                $Handler_Name
  199 0000000E         $Handler_Name
                               PROC
  200 0000000E                 EXPORT           $Handler_Name             [WEAK
]
  201 0000000E                 B                .
  202 0000000E                 ENDP
  203 0000000E                 MEND
