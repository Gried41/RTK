   30 00000000         
   31 00000000                 AREA             STACK, NOINIT, READWRITE, ALIGN
=3
   32 00000000         __stack_limit
   33 00000000         Stack_Mem
                               SPACE            Stack_Size
   34 00001000         __initial_sp
   35 00001000         
   36 00001000         
   37 00001000         ;<h> Heap Configuration
   38 00001000         ;  <o> Heap Size (in Bytes) <0x0-0xFFFFFFFF:8>
   39 00001000         ;</h>
   40 00001000         
   41 00001000 00001900 
                       Heap_Size
                               EQU              0x0001900
   42 00001000         
   43 00001000                 IF               Heap_Size != 0 



